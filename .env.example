# 复制为 .env 后填写。Compose 会从仓库根目录的 .env 读取这些变量。
ACCOUNT_CHECKER_ENCRYPTION_KEY=
CONSOLE_PASSWORD=
CONSOLE_SESSION_SECRET=

# 直连 HTTP 时设为 0；HTTPS 入口（包括自有反向代理）设为 1。
CONSOLE_COOKIE_SECURE=1

# Web 容器发布到主机的端口。
WEB_PORT=3000
# 同一主机部署多个副本时设为唯一名称；不要在模式间改变。
COMPOSE_PROJECT_NAME=mailcom-account-checker

# 0=生产，1=本地隔离 Mocker；两种模式共用以上密钥和密码，但数据卷独立。
MAIL_MOCKER_MODE=0
