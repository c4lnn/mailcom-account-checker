FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ACCOUNT_CHECKER_DB=/data/account-checker.sqlite3

WORKDIR /app
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY account_console ./account_console
COPY *.py ./
RUN mkdir -p /data

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "account_console.api:app", "--host", "0.0.0.0", "--port", "8000"]
